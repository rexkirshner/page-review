{
  "manifest_version": 3,
  "name": "Page Review",
  "version": "0.1.0",
  "description": "Annotate rendered pages and export comments with evidence that identifies each target.",
  "minimum_chrome_version": "109",
  "permissions": ["activeTab", "scripting", "storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "19": "icons/icon19.png",
      "38": "icons/icon38.png"
    },
    "default_title": "Toggle Page Review"
  },
  "background": {
    "service_worker": "background.js"
  }
}
